<h1>
    <%= title %>
</h1>
<p>
    <%= message %>
</p>
<a href="/houses/create" class="btn btn-success">Create New House</a>
<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>House Name</th>
            <th>House Color</th>
           
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% houses.forEach((house)=> { %>
            <tr>
                <td>
                    <%= house.house_name %>
                </td>
                <td>
                    <%= house.house_color %>
                </td>

                <td>
                    <button onclick="window.location.href='/houses/<%= house.id %>/show' "
                        class="btn btn-info">View</button>
                    <button onclick="window.location.href='/houses/<%= house.id %>/edit' "
                        class="btn btn-primary">Edit</button>
                    <form action="/houses/<%= house.id %>?_method=DELETE" method="POST" style="display:inline;"
                        onsubmit="return confirm('Are you sure you want to delete this house?');">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
               
                </td>

            </tr>
            <% }); %>
    </tbody>
</table>