<h1>
    <%= house.house_name %>'s Details
</h1>
<p>
    <%= message %>
</p>


<table border="1" cellpadding="5" cellspacing="0"
    style="border-collapse: collapse; width: 100%; color: #091fe6; font-family: Arial, sans-serif;">
    <tr>
        <td>House Name</td>
        <td>
            <%= house.house_name %>
        </td>
    </tr>
    <tr>
        <td>House Color</td>
        <td>
            <%= house.house_color %>
        </td>
    </tr>
 

    <tr>
        <td>Action</td>
        <td>
            <button onclick="window.location.href='/houses/<%= house.id %>/edit'" class="btn btn-info">Edit</button>
            <form action="/houses/<%= house.id %>?_method=DELETE" method="POST" style="display:inline;"
                onsubmit="return confirm('Are you sure you want to delete this house?');">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>

        </td>
    </tr>
    <button onclick="window.location.href='/houses'" class="btn btn-primary">Back to House List</button>
</table>