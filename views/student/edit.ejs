<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/student/<%=studentId %>?_method="put" method="POST">
        <label for="name">Name:</label>
        <input type="text" id="name" name="name" value="<%= studentName %>"><br><br>
        <label for="age">Age:</label>
        <input type="number" id="age" name="age" value="<%= studentAge %>"><br><br>
        <input type="submit" value="Update Student">
</body>
</html>