    <table  border="1" cellpadding="5" cellspacing="0" style="border-collapse: collapse; width: 100%; color: #091fe6; font-family: Arial, sans-serif;" >
        <tr>
            <td>Admission No</td>
            <td>
                <%= student.admission_number %>
            </td>
        </tr>
        <tr>
            <td>First Name</td>
            <td>
                <%= student.first_name %>
            </td>
        </tr>
        <tr>
            <td>Last Name</td>
            <td>
                <%= student.last_name %>
            </td>
        </tr>
        <tr>
            <td>Gender</td>
            <td>
                <%= student.gender %>
            </td>
        </tr>
        <tr>
            <td>Date of Birth</td>
            <td>
                <%= student.date_of_birth %>
            </td>
        </tr>
        <tr>
            <td>NIC Number</td>
            <td>
                <%= student.nic_number %>
            </td>
        </tr>
        <tr>
            <td>Birth Cerfificate No</td>
            <td>
                <%= student.birth_certificate_number %>

            </td>
        </tr>

        <tr>
            <td>Address</td>
            <td>
                <%= student.per_address %>
            </td>
        </tr>

        <tr>
            <td> Phone No   </td>
            <td>
                <%= student.tele_number %>

            </td>
        </tr>

        <tr>
            <td>House ID</td>
            <td>
                <%=student.house_id %>

            </td>
        </tr>

        <tr>
            <td>Grade ID</td>.
            <td>
                <%=student.grade_id %>

            </td>
        </tr>

        <tr>
            <td>Medium</td>
            <td>
                <%=student.medium %>

            </td>
        </tr>
        <tr>
            <td>Date of Admission</td>
            <td>
                <%=student.date_of_admission %>

            </td>
        </tr>

        <tr>
            <td> Permanent Address</td>
            <td>
                <%=student.per_address%>
            </td>
        </tr>


        <tr>
            <td>Action</td>
            <td>
                <button onclick="window.location.href='/student/<%= student.id %>/edit'" class="btn btn-info">Edit</button>
                <form action="/student/<%= student.id %>?_method=DELETE" method="POST" style="display:inline;"
                    onsubmit="return confirm('Are you sure you want to delete this student?');">
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
              
            </td>
        </tr>
        <button onclick="window.location.href='/student'" class="btn btn-primary">Back to Student List</button>
    </table>

