<h1>
    <%= title %>
</h1>
<p>
    <%= message %>
</p>
<table border="1" cellpadding="10" cellspacing="0" style="
    border-collapse: collapse; 
    width: 100%; 
    background-color: #6af071; 
    text-align: left;
    color: #0a1bb5;
    font-family: Arial, sans-serif;
    border: 2px solid #090a0a;
  ">
    <thead>
        <tr>
            <th>Admission No</th>
            <th>First Name</th>
            <th>Last Name</th>
            <!-- <th>Gender</th>
            <th>Medium</th> -->
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% students.forEach((student)=> { %>
            <tr>
                <td>
                    <%= student.admission_number %>
                </td>
                <td>
                    <%= student.first_name %>
                </td>
                <td>
                    <%= student.last_name %>
                </td>
                <!-- <td>
                    <%= student.gender %>
                </td>
                <td>
                    <%= student.medium %>   
                </td> -->
                <td>
                    <button onclick="window.location.href='/student/<%= student.id %>/show'">View</button>
                    <!-- <a href="/student/<%= student.id %>/show">View</a> -->
                </td>
               
            </tr>
            <% }); %>
    </tbody>
</table>