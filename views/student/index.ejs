<h1>
    <%= title %>
</h1>
<p>
    <%= message %>
</p>
<a href="/student/create" class="btn btn-success">Create New Student</a>
<table 
  class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Admission No</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Gender</th>
            
            <th>Action</th>
        </tr>
    </thead>
    <tbody >
        <% students.forEach((student)=> { %>
            <tr>
                <td>
                    <%= student.admission_number %>
                </td>
                <td>
                    <%= student.first_name %>
                </td>
                <td>
                    <%= student.last_name %>
                </td>
               <td>
                    <%= student.gender %>
                </td>
               
                <td>
                    <button onclick="window.location.href='/student/<%= student.id %>/show' " class="btn btn-info">View</button>
                    <button onclick="window.location.href='/student/<%= student.id %>/edit' " class="btn btn-primary">Edit</button>
                    <form action="/student/<%= student.id %>?_method=DELETE" method="POST" style="display:inline;"
                        onsubmit="return confirm('Are you sure you want to delete this student?');">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                    <!-- <a href="/student/<%= student.id %>/show">View</a> -->
                </td>
               
            </tr>
            <% }); %>
    </tbody>
</table>