<h1>
    <%= title %>
</h1>
<p>
    <%= message %>
</p>
<a href="/subjects/create" class="btn btn-success">Create New Subject</a>
<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Subject Name</th>
            <th>Subject Index</th>
            <th>Subject Order</th>
            <th>Subject Number</th>
            <th>Colour</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% subjects.forEach((subject)=> { %>
            <tr>
                <td>
                    <%= subject.subject_name %>
                </td>
                <td>
                    <%= subject.subject_index %>
                </td>
                <td>
                    <%= subject.subject_order %>
                </td>
                <td>
                    <%= subject.subject_number %>
                </td>
                <td>
                    <%= subject.colour %>
                </td>

                <td>
                    <button onclick="window.location.href='/subjects/<%= subject.id %>/show' "
                        class="btn btn-info">View</button>
                    <button onclick="window.location.href='/subjects/<%= subject.id %>/edit' "
                        class="btn btn-primary">Edit</button>
                    <form action="/subjects/<%= subject.id %>?_method=DELETE" method="POST" style="display:inline;"
                        onsubmit="return confirm('Are you sure you want to delete this subject?');">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                    
                </td>

            </tr>
            <% }); %>
    </tbody>
</table>