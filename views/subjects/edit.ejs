<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white text-center">
            <h3>Edit Subject Form</h3>
        </div>

        <div class="card-body">
            <form action="/subjects/<%= subject.id %>?_method=PUT" method="POST" class="row g-3">
                <div class="col-md-6">
                    <label for="subject_name" class="form-label">Subject Name:</label>
                    <input type="text" class="form-control" id="subject_name" name="subject_name" required
                        placeholder="Enter subject name" value="<%= subject.subject_name %>">
                </div>
                <div class="col-md-6">
                    <label for="subject_index" class="form-label">Subject Index:</label>
                    <input type="text" class="form-control" id="subject_index" name="subject_index" required
                        placeholder="Enter subject index" value="<%= subject.subject_index %>">
                </div>
                <div class="col-md-6">
                    <label for="subject_order" class="form-label">Subject Order:</label>
                    <input type="text" class="form-control" id="subject_order" name="subject_order" required
                        placeholder="Enter subject order" value="<%= subject.subject_order %>">
                </div>



                <div class="col-md-6">
                    <label for="subject_number" class="form-label">Subject Number:</label>
                    <input type="number" class="form-control" id="subject_number" name="subject_number"
                        placeholder="Enter subject number" value="<%= subject.subject_number %>">
                </div>

                <div class="col-md-6">
                    <label for="colour" class="form-label">Colour:</label>
                    <input type="text" class="form-control" id="colour" name="colour" placeholder="Enter colour" value="<%= subject.colour %>">
                </div>

                <div class="col-12 text-center mt-4">
                    <input type="submit" value="Submit" class="btn btn-primary px-4 me-2">
                    <input type="reset" value="Reset" class="btn btn-danger px-4">
                </div>
            </form>
        </div>
    </div>
</div>