<h1>
    <%= title %>
</h1>
<p>
    <%= message %>
</p>
<a href="/family/create" class="btn btn-success">Create New Family</a>
<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Family ID</th>
            <th>Father's first Name</th>
            <th>Mother's first Name</th>
            <th>Father's NIC Number</th>
            <th>Mother's NIC Number</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% families.forEach((family)=> { %>
            <tr>
                <td>
                    <%= family.id %>
                </td>
                <td>
                    <%= family.fa_first_name %>
                </td>
                <td>
                    <%= family.mo_first_name %>
                </td>
                <td>
                    <%= family.fa_nic_number %>
                </td>
                <td>
                    <%= family.mo_nic_number %>
                </td>

                <td>
                    <button onclick="window.location.href='/family/<%= family.id %>/show' "
                        class="btn btn-info">View</button>
                    <button onclick="window.location.href='/family/<%= family.id %>/edit' "
                        class="btn btn-primary">Edit</button>
                    <form action="/family/<%= family.id %>?_method=DELETE" method="POST" style="display:inline;"
                        onsubmit="return confirm('Are you sure you want to delete this family?');">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                   
                </td>

            </tr>
            <% }); %>
    </tbody>
</table>