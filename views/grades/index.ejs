<h1>
    <%= title %>
</h1>
<p>
    <%= message %>
</p>
<a href="/grades/create" class="btn btn-success">Create New Grade</a>
<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Grade Name</th>
            <th>Grade Group</th>
            <th>Grade Order</th>
            <th>Colour</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% grades.forEach((grade)=> { %>
            <tr>
                <td>
                    <%= grade.grade_name %>
                </td>
                <td>
                    <%= grade.grade_group %>
                </td>
                <td>
                    <%= grade.grade_order %>
                </td>
                <td>
                    <%= grade.colour %>
                </td>

                <td>
                    <button onclick="window.location.href='/grades/<%= grade.id %>/show' "
                        class="btn btn-info">View</button>
                    <button onclick="window.location.href='/grades/<%= grade.id %>/edit' "
                        class="btn btn-primary">Edit</button>
                    <form action="/grades/<%= grade.id %>?_method=DELETE" method="POST" style="display:inline;"
                        onsubmit="return confirm('Are you sure you want to delete this grade?');">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                    <!-- <a href="/grades/<%= grade.id %>/show">View</a> -->
                </td>

            </tr>
            <% }); %>
    </tbody>
</table>