<h1>
    <%= teacher.first_name %>'s Details
</h1>
<p>
    <%= message %>
</p>


<table border="1" cellpadding="5" cellspacing="0"
    style="border-collapse: collapse; width: 100%; color: #091fe6; font-family: Arial, sans-serif;">
    <tr>
        <td>Registration No</td>
        <td>
            <%= teacher.registration_number %>
        </td>
    </tr>
    <tr>
        <td>Nic Number</td>
        <td>
            <%=teacher.nic_number %>

        </td>
    </tr>
    <tr>
        <td>First Name</td>
        <td>
            <%= teacher.first_name %>
        </td>
    </tr>
    <tr>
        <td>Last Name</td>
        <td>
            <%= teacher.last_name %>
        </td>
    </tr>
    <tr>
        <td>Gender</td>
        <td>
            <%= teacher.gender %>
        </td>
    </tr>
    <tr>
        <td>Title</td>
        <td>
           <%=teacher.title %>
        </td>
    </tr>

    <tr>

        <td>Date of Birth</td>
        <td>
            <%= teacher.date_of_birth %>
        </td>
    </tr>

    <tr>
        <td>Address</td>
        <td>
            <%= teacher.permanent_address %>
        </td>
    </tr>

    
    <tr>
        <td>Action</td>
        <td>
            <button onclick="window.location.href='/teachers/<%= teacher.id %>/edit'" class="btn btn-info">Edit</button>
            <form action="/teachers/<%= teacher.id %>?_method=DELETE" method="POST" style="display:inline;"
                onsubmit="return confirm('Are you sure you want to delete this teacher?');">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
          
        </td>
    </tr>
    <button onclick="window.location.href='/teachers'" class="btn btn-primary">Back to Teacher List</button>
</table>

