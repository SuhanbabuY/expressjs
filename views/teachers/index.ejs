<h1>
    <%= title %>
</h1>
<p>
    <%= message %>
</p>
<a href="/teachers/create" class="btn btn-success">Create New Teacher</a>
<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Registration No</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Gender</th>

            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% teachers.forEach((teacher)=> { %>
            <tr>
                <td>
                    <%= teacher.registration_number %>
                </td>
                <td>
                    <%= teacher.first_name %>
                </td>
                <td>
                    <%= teacher.last_name %>
                </td>
                <td>
                    <%= teacher.gender %>
                </td>

                <td>
                    <button onclick="window.location.href='/teachers/<%= teacher.id %>/show' "
                        class="btn btn-info">View</button>
                    <button onclick="window.location.href='/teachers/<%= teacher.id %>/edit' "
                        class="btn btn-primary">Edit</button>
                    <form action="/teachers/<%= teacher.id %>?_method=DELETE" method="POST" style="display:inline;"
                        onsubmit="return confirm('Are you sure you want to delete this teacher?');">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                  
                </td>

            </tr>
            <% }); %>
    </tbody>
</table>